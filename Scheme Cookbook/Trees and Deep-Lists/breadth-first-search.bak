#lang simply-scheme

(define make-tree cons)
(define datum car)
(define children cdr)

(define (breadth-first-search tree)
  (bfs-iter (list tree)))

(define (bfs-iter queue)
  (if (empty? queue) "done"
      (let ((task (car queue)))
        (print (datum task))
        (bfs-iter (append(cdr queue)(children task))))))



(define music-tree '(music (beatles (Johny)(Ringo)) (Queen (Krix)(Klan))))